{
  "apiVersion": "platform.storscale.io/v1alpha1",
  "kind": "Project",
  "metadata": {
    "name": "sales"
  },
  "spec": {
    "description": "Orders and payroll: the tables the integration guides use.",
    "members": [
      {
        "group": "engineers",
        "role": "editor"
      },
      {
        "group": "analysts",
        "role": "reader"
      }
    ],
    "tables": {
      "namespace": "sales",
      "readers": {
        "tables": [
          "orders"
        ],
        "rowFilters": [
          {
            "table": "orders",
            "filter": "region = 'EU'"
          }
        ],
        "masks": [
          {
            "table": "orders",
            "column": "card_number",
            "type": "MASK_SHOW_LAST_4"
          }
        ]
      },
      "checks": [
        {
          "table": "orders",
          "column": "id",
          "check": "unique"
        },
        {
          "table": "orders",
          "column": "card_number",
          "check": "notNull"
        },
        {
          "table": "orders",
          "check": "rowCount",
          "min": 1
        }
      ]
    },
    "files": {
      "bucket": "sales"
    },
    "pipelines": {
      "serviceAccount": "airflow-pipelines"
    }
  }
}
