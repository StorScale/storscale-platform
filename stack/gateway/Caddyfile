# The gateway: one domain, a name per tool, all on STORSCALE_PORT.
{
	auto_https off
	admin off
}

# A tool the platform shows in a frame: only the platform's pages may frame
# it. (A tool that says so itself, as JupyterHub does, keeps its own policy.)
(framed) {
	reverse_proxy {args[0]} {
		header_down -X-Frame-Options
	}
	header ?Content-Security-Policy "frame-ancestors 'self' http://{$STORSCALE_DOMAIN}:{$STORSCALE_PORT}"
}

http://{$STORSCALE_DOMAIN}:{$STORSCALE_PORT} {
	reverse_proxy platformd:8080
}

http://auth.{$STORSCALE_DOMAIN}:{$STORSCALE_PORT} {
	reverse_proxy keycloak:8080
}

http://notebooks.{$STORSCALE_DOMAIN}:{$STORSCALE_PORT} {
	import framed jupyterhub:8000
}

http://dashboards.{$STORSCALE_DOMAIN}:{$STORSCALE_PORT} {
	import framed superset:8088
}

http://pipelines.{$STORSCALE_DOMAIN}:{$STORSCALE_PORT} {
	import framed airflow:8090
}

http://monitoring.{$STORSCALE_DOMAIN}:{$STORSCALE_PORT} {
	import framed grafana:3000
}

http://access.{$STORSCALE_DOMAIN}:{$STORSCALE_PORT} {
	reverse_proxy ranger-admin:6080
}

http://s3.{$STORSCALE_DOMAIN}:{$STORSCALE_PORT} {
	reverse_proxy buckets:9000
}

# Any other name: the health check, and nothing else.
http://:{$STORSCALE_PORT} {
	respond /healthz "ok" 200
	respond "Not found: use http://{$STORSCALE_DOMAIN}:{$STORSCALE_PORT}" 404
}
